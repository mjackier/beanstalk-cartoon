# Copy this file to .env and fill it in. .env is git-ignored: real keys never go in the repo.
# (A pre-commit check in scripts/ blocks any commit that contains a Stripe or OpenAI key.)
# Enable the check once per clone:  git config core.hooksPath scripts/hooks

OPENAI_API_KEY=paste-your-key-here
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_INPUT_FIDELITY=high
OPENAI_VISION_MODEL=gpt-4.1-mini
# Quality of the per-book pages (speed) and of the pre-generated scenes (done once)
PAGE_QUALITY=low
SCENE_QUALITY=medium

# Stripe TEST key only (sk_test_...). The server refuses live keys.
STRIPE_SECRET_KEY=

# Postgres. Locally: postgres://postgres@127.0.0.1:5432/beanstalk
DATABASE_URL=

# Google sign-in (Google Cloud Console -> Google Auth Platform -> Clients -> Web application)
# Authorized redirect URI for local testing: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Long random string that signs the login cookie
SESSION_SECRET=

# Drawing pictures needs this password (protects the OpenAI bill). Empty = open.
GENERATE_PASSWORD=

# Comma-separated emails that may open the Scenes admin page (user #1 always can)
ADMIN_EMAILS=

# Local testing only: /auth/dev signs in without Google (localhost requests only)
DEV_LOGIN=0

# Copy this file to .env and put your real key there. .env is git-ignored.
OPENAI_API_KEY=paste-your-key-here

# Model settings. gpt-image-1.5 + high input fidelity keeps faces closest to the photo.
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_INPUT_FIDELITY=high
OPENAI_IMAGE_QUALITY=low

# Set to 1 to test the pipeline and PDF without calling OpenAI (free).
MOCK_IMAGES=0

# If set, generating images requires this password. Leave empty locally if you like.
GENERATE_PASSWORD=
